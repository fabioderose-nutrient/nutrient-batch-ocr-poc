# GdPicture.NET license key. Empty = evaluation mode (watermarked output).
GDPICTURE_LICENSE_KEY=
# Folder with the PDFs to OCR (relative to the current directory).
OCR_INPUT_DIR=samples
# Folder for the searchable PDFs.
OCR_OUTPUT_DIR=output
# Folder with the .traineddata files. Empty = the GdPicture.Resources package in the NuGet cache.
OCR_RESOURCES_PATH=
# OCR language, for example eng or eng+fra.
OCR_LANGUAGE=eng
